{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FPSEditor Win64 Development",
			"type": "process",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/c",
				".vscode\\build-editor.bat"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			}
		}
	]
}
